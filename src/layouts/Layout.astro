---
import "../global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Personal website of Valerio Clemenzi" />
    <link rel="icon" type="image/x-icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-zinc-900 text-white">
    <slot />
  </body>
</html>