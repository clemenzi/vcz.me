---
import { getCollection, render } from "astro:content";
import "../../global.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Personal website of Valerio Clemenzi" />
    <link rel="icon" type="image/x-icon" href="/favicon.svg" />
    <title>
      {post.data.title} - vcz.me
    </title>
  </head>
  <body class="bg-stone-900 text-white">
    <div class="max-w-2xl mx-auto py-12 space-y-4">
      <div class="flex items-center justify-between">
        <a href="/" class="text-white/80 hover:underline">
          &larr; Back to home
        </a>
      </div>
      <h1 class="text-4xl font-extrabold">{post.data.title}</h1>
      <div class="prose dark:prose-invert">
        <Content />
      </div>
    </div>
  </body>
</html>
