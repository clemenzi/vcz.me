---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: {
      id: post.id,
    },
    props: {
      post,
      otherLanguages: posts
        .filter((p) => p.data.original === post.id)
        .map((p) => ({
          ...p,
          languageLabel: p.data.lang === "it" ? "Italiano" : "English",
        })),
    },
  }));
}

const { post, otherLanguages } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <div class="max-w-prose mx-auto py-12 space-y-4 px-4">
    <div class="flex items-center justify-between">
      <a href="/" class="text-white/80 hover:underline font-display text-xs sm:text-base">
        &larr; Back to home
      </a>

      <span class="text-white/70 italic font-display text-right text-xs sm:text-base">
        Written by Valerio on {new Date(post.data.date).toLocaleDateString()}
      </span>
    </div>
    <div class="space-y-1">
      <h1 class="text-4xl font-display font-bold text-blue-300">
        {post.data.title}
      </h1>
      {
        otherLanguages.length > 0 && (
          <span class="text-white/80 italic">
            This post is also available in{" "}
            {otherLanguages.map((l, i) => (
              <a href={`/blog/${l.id}`} class="text-lime-200/90 hover:underline">
                {l.languageLabel} {i < otherLanguages.length - 1 && ", "}
              </a>
            ))}
          </span>
        )
      }
    </div>
    <div
      class="prose prose-invert prose-headings:font-display prose-h1:text-blue-200 prose-h2:text-orange-200 prose-h3:text-yellow-200 prose-h4:text-lime-200 prose-h5:text-white prose-h5:font-semibold"
    >
      <Content />
    </div>
    <footer class="italic text-blue-200 font-display space-x-0.5">
      <span class="text-amber-200"> Thanks for reading! </span>
      <a href="/" class="text-white/80 hover:underline">
        &larr; Back to home
      </a>
    </footer>
  </div>
</Layout>
