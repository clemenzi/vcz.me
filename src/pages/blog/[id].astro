---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <div class="max-w-prose mx-auto py-12 space-y-4 px-4">
    <div class="flex items-center justify-between">
      <a href="/" class="text-white/80 hover:underline font-display">
        &larr; Back to home
      </a>
    </div>
    <div class="space-y-1">
      <h1 class="text-5xl font-display font-bold text-blue-300">
        {post.data.title}
      </h1>
      <span class="text-white/80 italic text-lg">
        Written by Valerio on {new Date(post.data.date).toLocaleDateString()}
      </span>
    </div>
    <div class="prose dark:prose-invert">
      <Content />
    </div>
    <footer class="italic text-blue-200 font-display space-x-0.5">
      <span class="text-amber-200"> Thanks for reading! </span>
      <a href="/" class="text-white/80 hover:underline">
        &larr; Back to home
      </a>
    </footer>
  </div>
</Layout>
