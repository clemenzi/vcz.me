---
import { getCollection } from "astro:content";
import "../global.css";

const posts = await getCollection("blog");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Personal website of Valerio Clemenzi" />
    <link rel="icon" type="image/x-icon" href="/favicon.svg" />
    <title>vcz.me</title>
  </head>
  <body class="bg-stone-900 text-white">
    <div class="flex flex-col items-center gap-4 pt-24 px-6">
      <div class="text-left space-y-4">
        <div>
          <h1 class="text-4xl font-extrabold">vcz.me</h1>
          <p class="text-lg max-w-prose">
            Hello, I'm Valerio, and i build "stuff" on the internet. By-design,
            this website is almost empty, because I want my work to speak for
            me.
          </p>
        </div>
        <div>
          <h2 class="text-2xl font-semibold">
            Projects, Cool Things, Experiments
          </h2>
          <ul>
            <li>
              <a
                href="https://www.manuale.dev"
                class="hover:underline text-blue-300"
              >
                manuale.dev: Manuale di programmazione per neofiti (ITALIAN)
              </a>
            </li>
            <li>
              <a
                href="https://chromewebstore.google.com/detail/caiibdnacbgkdknjedbblmmnmhnnpflo"
                class="hover:underline text-blue-300"
              >
                instagram-who-refollows: See who doesn't follow you back (Chrome
                Extension)
              </a>
            </li>
            <li>
              <a
                href="https://chromewebstore.google.com/detail/dont-show/gdebfgieajfdgdcdmpnbakflnkoaankk"
                class="hover:underline text-blue-300"
              >
                dontshow: Hide sensitive information from websites (Chrome
                Extension)
              </a>
            </li>
            <li>
              <a
                href="https://github.com/clemenzi/spotify-background"
                class="hover:underline text-blue-300"
              >
                spotify-background: Make your macos wallpaper match your current
                song (vibe coded, experimental)
              </a>
            </li>
            <li>
              <a
                href="https://github.com/clemenzi/evoshosting.com"
                class="hover:underline text-blue-300"
              >
                evoshosting.com: Archived, read-only source code of the old
                EvosHosting website
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl font-semibold">Useful Links</h2>
          <ul>
            <li>
              <a
                href="https://github.com/clemenzi"
                class="hover:underline text-blue-300"
              >
                github.com/clemenzi
              </a>
            </li>
            <li>
              <a
                href="https://www.linkedin.com/in/vclemenzi/"
                class="hover:underline text-blue-300"
              >
                linkedin.com/in/vclemenzi
              </a>
            </li>
            <li>
              <a
                href="https://www.last.fm/user/kidvcz"
                class="hover:underline text-blue-300"
              >
                last.fm/user/kidvcz
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-2xl font-semibold">Blog Posts</h2>
          <ul>
            {
              posts.length > 0 ? (
                posts.map((post: { id: string; data: { title: string } }) => (
                  <li>
                    <a
                      href={`/blog/${post.id}`}
                      class="hover:underline text-blue-300"
                    >
                      {post.data.title}
                    </a>
                  </li>
                ))
              ) : (
                <li class="text-white/60">Umm... no posts yet.</li>
              )
            }
          </ul>
        </div>
        <div>
          <footer class="italic text-white/70">
            <span> (c) 2025 Valerio Clemenzi. </span>
            <a href="mailto:me@vcz.me" class="hover:underline"
              >Mail me at me@vcz.me</a
            >
          </footer>
        </div>
      </div>
    </div>
  </body>
</html>
